# XIAO-57 · 登录系统
# 由 @DevOps 注入真实值（不入 Git，见 MULTICA.md §5）
JWT_SECRET=__set_in_runtime__min_32_bytes__
JWT_EXPIRES_IN=8h
NODE_ENV=development
APP_ENV=dev

# 数据库
DB_TYPE=sqlite
DB_DATABASE=:memory:

# CORS 白名单（G2-GAP-CORS-1 修复）
# - 留空 → CORS 关闭（强制同源；prod 同源部署安全默认）
# - 单 origin：http://example.com
# - 多 origin 逗号分隔：http://a.com,http://b.com
WEB_ORIGIN=