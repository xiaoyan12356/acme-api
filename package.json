{
  "name": "acme-api",
  "version": "0.1.0",
  "private": true,
  "description": "XIAO-57 login system backend (NestJS+TypeORM local bootstrap, B' path)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest --config jest.config.js",
    "test:coverage": "jest --config jest.config.js --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "ts-node scripts/seed.ts",
    "migrate": "ts-node src/migrations/run-migration.ts",
    "start:dev": "ts-node src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.7",
    "@nestjs/core": "^10.4.7",
    "@nestjs/platform-express": "^10.4.7",
    "@nestjs/testing": "^10.4.22",
    "@nestjs/typeorm": "^10.0.2",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.5",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "sqlite3": "^5.1.7",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
